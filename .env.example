# Google AI Studio anahtari; bkz. README "Retranslate ve Gemini Yukseltme". Bos birakilirsa Gemini hic denenmez.
GEMINI_API_KEY=

# Django imza anahtari. DEBUG=False iken zorunlu; bos, ornek ya da 32 karakterden
# kisa deger uygulamayi acmaz. Uretmek icin: openssl rand -hex 32
SECRET_KEY=

# Paylasilan yerel PostgreSQL'de (yerel-platform reposu) cybernews kullanicisinin parolasi.
# Zorunlu; bos birakilirsa compose acilmaz. Olusturmak icin yerel-platform'da:
#   UYGULAMA_PAROLASI="$(openssl rand -hex 24)" scripts/uygulama_ekle.sh cybernews
# ve ayni degeri buraya yazin.
DB_PASSWORD=

# Istege bagli. GitHub Releases API anonim limiti 60 istek/saat/IP'dir; DevTools cekimi
# tur basina ~15 istek yapar (MinIO, RabbitMQ, Elastic x2, Moodle, LiteLLM, LangGraph,
# Langfuse, Keycloak + K8s ve GitHub Advisory). Bos birakilabilir; verilirse yalniz
# api.github.com isteklerine Bearer baslik olarak eklenir (limit 5000/saat).
# Uretmek icin: github.com -> Settings -> Developer settings -> Fine-grained token,
# "Public repositories (read-only)" yeterlidir.
GITHUB_TOKEN=
